# Sui network the wallet + gRPC clients target: testnet | mainnet | devnet
VITE_ENVIRONMENT=testnet

# Orderbook service base URL. Local service default; deployed builds use the
# nginx route, e.g. https://<host>/staging/orderbook (prefix is stripped).
VITE_ORDERBOOK_URL=http://127.0.0.1:9014

# contracts/exchange package id (from the exchange publish ceremony). Required
# for swap execution and market creation; without it the screens are read-only.
VITE_EXCHANGE_PACKAGE_ID=

# Optional explorer override; defaults to suivision for VITE_ENVIRONMENT.
VITE_EXPLORER_URL=
