# Multi-stage build for event-ingestor (go-backend).
#
# Static Go binary (CGO off) on a bookworm-slim runtime — kept debian (not
# scratch) so the compose curl healthcheck and ca-certificates exist (the
# poller speaks TLS to the public Sui GraphQL endpoint).
FROM golang:1.24-bookworm AS builder
WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 go build -o /out/event-ingestor ./cmd/event-ingestor

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=builder /out/event-ingestor /usr/local/bin/event-ingestor
COPY cmd/event-ingestor/config/ /app/config/

ENV APP_ENV=staging
ENTRYPOINT ["/bin/sh", "-c", "exec /usr/local/bin/event-ingestor \
  --config /app/config/config.${APP_ENV}.toml"]
