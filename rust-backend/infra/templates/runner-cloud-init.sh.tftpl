#!/usr/bin/env bash
# Auto-generated by Terraform. Runs once at first boot via spot user_data.
# After this, restarts/spot-resume cycles run the systemd unit directly.
set -euxo pipefail

# Env consumed by runner-bootstrap.sh, register-runner.sh, and gh-runner.service.
cat > /etc/default/gh-runner <<EOF
GITHUB_REPO=${github_repo}
RUNNER_LABELS=${runner_labels}
PAT_SECRET_ARN=${pat_secret_arn}
AWS_REGION=${aws_region}
RUNNER_VERSION=${runner_version}
EOF
chmod 0644 /etc/default/gh-runner

cat > /usr/local/sbin/runner-bootstrap.sh <<'BOOTSTRAP_EOF'
${bootstrap_script}
BOOTSTRAP_EOF
chmod +x /usr/local/sbin/runner-bootstrap.sh

cat > /usr/local/sbin/register-runner.sh <<'REG_EOF'
${register_script}
REG_EOF
chmod +x /usr/local/sbin/register-runner.sh

cat > /etc/systemd/system/gh-runner.service <<'UNIT_EOF'
${systemd_unit}
UNIT_EOF

/usr/local/sbin/runner-bootstrap.sh
