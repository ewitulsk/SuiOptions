#!/usr/bin/env bash
# Auto-generated by Terraform. Runs once at first boot via EC2 user_data.
set -euxo pipefail

# ---- Install Docker, AWS CLI, SSM Agent, lay out /opt/options/<env> --------
cat > /usr/local/sbin/options-ec2-bootstrap.sh <<'BOOTSTRAP_EOF'
${bootstrap_script}
BOOTSTRAP_EOF
chmod +x /usr/local/sbin/options-ec2-bootstrap.sh
/usr/local/sbin/options-ec2-bootstrap.sh

# ---- Drop per-env compose files + deploy/render scripts --------------------
for env in dev staging prod; do
  mkdir -p "/opt/options/$env/secrets"
  chmod 700 "/opt/options/$env/secrets"
done

cat > /opt/options/dev/docker-compose.dev.yml <<'COMPOSE_DEV_EOF'
${compose_dev}
COMPOSE_DEV_EOF

cat > /opt/options/staging/docker-compose.staging.yml <<'COMPOSE_STAGING_EOF'
${compose_staging}
COMPOSE_STAGING_EOF

cat > /opt/options/prod/docker-compose.prod.yml <<'COMPOSE_PROD_EOF'
${compose_prod}
COMPOSE_PROD_EOF

for env in dev staging prod; do
  cat > "/opt/options/$env/deploy.sh" <<'DEPLOY_EOF'
${deploy_script}
DEPLOY_EOF
  chmod +x "/opt/options/$env/deploy.sh"

  cat > "/opt/options/$env/render-secrets.sh" <<'RENDER_EOF'
${render_secrets_sh}
RENDER_EOF
  chmod +x "/opt/options/$env/render-secrets.sh"
done

echo "options host bootstrap: complete"
