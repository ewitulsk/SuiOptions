#!/usr/bin/env bash
# Auto-generated by Terraform. Runs once at first boot via EC2 user_data.
#
# Dedicated prod host. Runs ONLY the prod compose stack plus a Promtail
# shipper that forwards container logs to the central Loki on the shared
# services host (${loki_url}). No Loki/Grafana/Gatus server and no Tailscale
# subnet router live here — those stay on the shared options-host.
set -euxo pipefail

# ---- Install Docker, AWS CLI, SSM Agent, lay out /opt/options/<env> --------
cat > /usr/local/sbin/options-ec2-bootstrap.sh <<'BOOTSTRAP_EOF'
${bootstrap_script}
BOOTSTRAP_EOF
chmod +x /usr/local/sbin/options-ec2-bootstrap.sh
/usr/local/sbin/options-ec2-bootstrap.sh

# ---- Drop the prod compose file + deploy/render scripts --------------------
mkdir -p /opt/options/prod/secrets
chmod 700 /opt/options/prod/secrets

cat > /opt/options/prod/docker-compose.prod.yml <<'COMPOSE_PROD_EOF'
${compose_prod}
COMPOSE_PROD_EOF

cat > /opt/options/prod/deploy.sh <<'DEPLOY_EOF'
${deploy_script}
DEPLOY_EOF
chmod +x /opt/options/prod/deploy.sh

cat > /opt/options/prod/render-secrets.sh <<'RENDER_EOF'
${render_secrets_sh}
RENDER_EOF
chmod +x /opt/options/prod/render-secrets.sh

# ---- Promtail (ships container logs to the central Loki) --------------------
# Promtail discovers Docker containers via the socket and pushes to the
# remote Loki at LOKI_URL — it does not need the monitoring Docker network
# or a local Loki. The server stack (Loki/Grafana/Gatus) is NOT run here.

MONITORING_DIR=/opt/options/monitoring
mkdir -p "$MONITORING_DIR/promtail/config"

cat > "$MONITORING_DIR/promtail/config/promtail-config.yml" <<'PROMTAIL_CFG_EOF'
${promtail_config}
PROMTAIL_CFG_EOF

cat > "$MONITORING_DIR/docker-compose.promtail.yml" <<'PROMTAIL_COMPOSE_EOF'
${promtail_compose}
PROMTAIL_COMPOSE_EOF

# .env for the promtail compose. DATA_DIR locates the bind-mounted config;
# LOKI_URL points at the shared host's Loki.
cat > "$MONITORING_DIR/.env" <<EOF
DATA_DIR=$MONITORING_DIR
AWS_REGION=${aws_region}
LOKI_URL=${loki_url}
EOF
chmod 600 "$MONITORING_DIR/.env"

# Start Promtail. Best-effort: a logging failure must never abort the
# bootstrap and leave the prod stack undeployed.
cd "$MONITORING_DIR"
docker compose -f docker-compose.promtail.yml pull || true
docker compose -f docker-compose.promtail.yml up -d || true

echo "options prod host bootstrap: complete"
