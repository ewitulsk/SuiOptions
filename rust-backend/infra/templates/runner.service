[Unit]
Description=GitHub Actions self-hosted runner (ephemeral, restart-on-exit)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=gh-runner
WorkingDirectory=/home/gh-runner/actions-runner
EnvironmentFile=/etc/default/gh-runner
# Re-register with a fresh ephemeral token on every start (runs as root
# via the '+' prefix; ExecStart drops back to the gh-runner user).
ExecStartPre=+/usr/local/sbin/register-runner.sh
ExecStart=/home/gh-runner/actions-runner/run.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
