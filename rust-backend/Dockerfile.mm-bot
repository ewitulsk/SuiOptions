# Target: linux/arm64 (Graviton EC2). bake.hcl sets platforms=linux/arm64
# and docker buildx emulates arm64 via QEMU on x86 GH runners. No
# `--platform=$BUILDPLATFORM` on the builder — that would native-compile
# to amd64 and the Graviton kernel would reject the binary with
# `Exec format error`.
FROM rust:1-bookworm AS builder
WORKDIR /src

RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config libssl-dev clang cmake protobuf-compiler git \
    && rm -rf /var/lib/apt/lists/*

COPY . .
RUN cargo build --release -p mm-bot

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates libssl3 curl && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=builder /src/target/release/mm-bot /usr/local/bin/mm-bot
COPY services/mm-bot/config/ /app/config/
COPY deployments.json /app/deployments.json

# Persistent state lives in /app/state (mm-bot.account.json). Mount a
# named volume there from compose so the Account survives container
# replacement.
RUN mkdir -p /app/state

ENV APP_ENV=dev
ENTRYPOINT ["/bin/sh", "-c", "exec /usr/local/bin/mm-bot \
  --config /app/config/config.${APP_ENV}.toml \
  --secrets /run/secrets/mm-bot.toml \
  --account-state /app/state/mm-bot.account.json"]
