# Daily instruments-fetcher run (spec §10.3). Driven by
# data-room-instruments.timer.
#
# Install (all units): cp deploy/systemd/* /etc/systemd/system/ &&
#   systemctl daemon-reload && systemctl enable --now data-room-{instruments,normalizer,gold,vision-sync}.timer

[Unit]
Description=data-room: fetch instrument reference data into silver/instruments
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/data-room
# All five lists default to BTC-only, so every new underlying has to be
# named here or it never reaches the instrument master (SO-406).
ExecStart=/usr/bin/docker compose run --rm batch normalizer instruments --coinbase-products BTC-USD,SUI-USD --binance-symbols BTCUSDC,SUIUSDT,SUIUSDC --binance-perp-symbols BTCUSDT,SUIUSDT --hyperliquid-coins BTC,SUI --deribit-currencies BTC
