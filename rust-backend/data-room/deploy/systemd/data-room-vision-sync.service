# Monthly incremental Binance Vision dump sync (spec §6.6). During the
# pre-live-capture seam, run daily instead by editing the timer's
# OnCalendar to `*-*-* 02:00:00 UTC`.
#
# One-shot FULL backfill (run manually, once, from /opt/data-room —
# expect hours of unzip churn; the spool volume is why this host has
# 100 GB):
#   docker compose run --rm batch vision-sync            # full mirror = default (add --since to bound)

[Unit]
Description=data-room: sync Binance Vision archives into bronze
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/data-room
# since last synced month).
# Symbols are explicit rather than defaulted: the default is BTCUSDC only,
# so a new underlying is invisible here until someone adds it (SO-406).
# bookTicker is deliberately absent — Binance stopped publishing it on
# 2024-03-30, so it is a one-shot backfill, not an ongoing feed.
ExecStart=/usr/bin/docker compose run --rm batch vision-sync --symbols BTCUSDC,SUIUSDT,SUIUSDC --kinds trades,aggTrades
ExecStart=/usr/bin/docker compose run --rm batch vision-sync --market um --symbols BTCUSDT,SUIUSDT --kinds trades,aggTrades,fundingRate
