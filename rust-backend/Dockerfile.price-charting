# Multi-stage build for price-charting. Mirrors Dockerfile.indexer — see the
# platform note there (no $BUILDPLATFORM pinning).
FROM rust:1-bookworm AS builder
WORKDIR /src

RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config libssl-dev clang cmake protobuf-compiler git \
    && rm -rf /var/lib/apt/lists/*

COPY . .
RUN cargo build --release -p price-charting

FROM debian:bookworm-slim
# libpq5: Postgres runtime lib for the diesel connection.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates libssl3 libpq5 curl && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=builder /src/target/release/price-charting /usr/local/bin/price-charting
COPY services/price-charting/config/ /app/config/

ENV APP_ENV=staging
# --secrets carries the shared Sui RPC override ([sui] rpc_url), rendered to
# /run/secrets/price-charting.toml by render-secrets.sh and bind-mounted by
# compose. Optional at runtime: a missing/un-rendered file degrades to the
# config / public RPC. (Baked here, not as a compose `command:` — the `sh -c`
# form swallows extra command args.)
ENTRYPOINT ["/bin/sh", "-c", "exec /usr/local/bin/price-charting --config /app/config/config.${APP_ENV}.toml --secrets /run/secrets/price-charting.toml"]
