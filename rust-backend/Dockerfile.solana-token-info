# Multi-stage build for solana-token-info.
#
# The builder runs under the target platform set by bake.hcl. Do NOT
# add `--platform=$BUILDPLATFORM` here — that would pin the builder to
# the GH runner's native arch and produce a binary that doesn't match
# the image manifest's arch (Graviton kernels reject mismatched arm64
# images with `Exec format error`).
FROM rust:1-bookworm AS builder
WORKDIR /src

RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config libssl-dev clang cmake protobuf-compiler git \
    && rm -rf /var/lib/apt/lists/*

# Copy the whole workspace. The Sui git deps make smarter caching strategies
# (just-Cargo.toml-first) fragile; one COPY is simpler and the layer rebuilds
# only when the workspace changes.
COPY . .
RUN cargo build --release -p solana-token-info

FROM debian:bookworm-slim
# libpq5 is the runtime shared lib the solana-token-info binary links against
# for Postgres. Without it the container errors at startup with
# `cannot open shared object file: libpq.so.5`.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates libssl3 libpq5 curl && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=builder /src/target/release/solana-token-info /usr/local/bin/solana-token-info
COPY services/solana-token-info/config/ /app/config/
# solana-deployments.json is NOT baked in (same mechanism as the Sui
# token-info's deployments.json). The staging/prod configs read it from
# /app/deployments/solana-deployments.json, a read-only directory bind-mount
# the deploy bundle drops on the host (/opt/options/<env>/deployments/).
# Decoupling it from the image means a program redeploy ships a new file +
# restarts this container instead of rebuilding every service. Local dev uses
# config.toml with a relative path, so this image is only runnable with the
# mount present (staging/prod) — by design.

ENV APP_ENV=staging
ENTRYPOINT ["/bin/sh", "-c", "exec /usr/local/bin/solana-token-info --config /app/config/config.${APP_ENV}.toml"]
