# Cargo build artefacts — workspace-wide, all crates share one target/.
/target/
**/target/

# Lockfile policy: keep `Cargo.lock` for workspaces that produce binaries
# (we do — `indexer` and `quoting-service`). NOT ignored.

# Local config overrides — commit the templated `config.toml` files under
# `services/<svc>/config/` and `tools/<svc>/config/`, but anything ending
# in `.local.toml` is developer-only (credentials, ephemeral ports, etc).
**/config/*.local.toml

# Per-binary secrets files — every signing binary reads its keys from its
# own `{services,tools}/<svc>/config/secrets.toml`. Commit the workspace-
# root template only.
**/config/secrets.toml
!secrets.example.toml

# MM bot's persisted Account bootstrap state — written on first run and
# read on subsequent runs. Re-creating it after a redeploy is fine.
**/mm-bot.account.json

# Env files in case anything ever reaches for one (we use TOML, not .env,
# but ignore them defensively).
.env
.env.*
!.env.example

# Editor / OS noise.
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Coverage / profiling outputs.
*.profraw
tarpaulin-report.html

# Backtester market data (fetched by tools/backtester/fetch-data.sh) and
# run outputs. Only the small fixtures/ files are committed.
tools/backtester/data/
tools/backtester/out/
