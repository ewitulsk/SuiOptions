# Multi-stage build for solana-gas-station.
#
# Build context is the REPO ROOT, not rust-backend/ (bake.hcl's
# `_solana-standalone` target sets context ".."): the service is a
# standalone cargo workspace, like solana-indexer, but it additionally
# path-depends on the program crates in ../solana-contracts/programs — a
# rust-backend-only context can't see them. The repo-root .dockerignore
# keeps the context to rust-backend/ + solana-contracts/.
#
# The builder runs under the target platform set by bake.hcl. Do NOT
# add `--platform=$BUILDPLATFORM` here — that would pin the builder to
# the GH runner's native arch and produce a binary that doesn't match
# the image manifest's arch (Graviton kernels reject mismatched arm64
# images with `Exec format error`).
FROM rust:1-bookworm AS builder
WORKDIR /src

RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config libssl-dev clang cmake protobuf-compiler git \
    && rm -rf /var/lib/apt/lists/*

# Both trees, laid out exactly as in the repo so the workspace's
# ../../../solana-contracts path deps resolve.
COPY rust-backend/ rust-backend/
COPY solana-contracts/ solana-contracts/
RUN cargo build --release --manifest-path rust-backend/services/solana-gas-station/Cargo.toml

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates libssl3 curl && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=builder /src/rust-backend/services/solana-gas-station/target/release/solana-gas-station /usr/local/bin/solana-gas-station
COPY rust-backend/services/solana-gas-station/config/ /app/config/

# Like the rest of the stack, both staging and prod currently run against
# the test cluster (Solana devnet); the per-env config carries `network`.
ENV APP_ENV=staging
# --secrets carries the station (fee payer + faucet mint authority) keypair
# ([solana] <network>), rendered to /run/secrets/solana-gas-station.toml by
# render-secrets.sh from options/<env>/solana-gas-station + the shared
# options/<env>/solana-rpc override.
ENTRYPOINT ["/bin/sh", "-c", "exec /usr/local/bin/solana-gas-station --config /app/config/config.${APP_ENV}.toml --secrets /run/secrets/solana-gas-station.toml"]
