# Multi-stage build for balance-monitor.
#
# The builder runs under the target platform set by bake.hcl. Do NOT add
# `--platform=$BUILDPLATFORM` here — that would pin the builder to the GH
# runner's native arch and produce a binary that doesn't match the image
# manifest's arch.
FROM rust:1-bookworm AS builder
WORKDIR /src

RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config libssl-dev clang cmake protobuf-compiler git \
    && rm -rf /var/lib/apt/lists/*

# Copy the whole workspace. The Sui git deps make smarter caching strategies
# fragile; one COPY is simpler and the layer rebuilds only when the workspace
# changes.
COPY . .
RUN cargo build --release -p balance-monitor

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates libssl3 curl && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=builder /src/target/release/balance-monitor /usr/local/bin/balance-monitor
COPY services/balance-monitor/config/ /app/config/

ENV APP_ENV=staging
# --secrets carries the shared Sui RPC override ([sui] rpc_url), rendered to
# /run/secrets/balance-monitor.toml by render-secrets.sh (separate from the
# per-watch secrets files this service reads to resolve wallet addresses).
# Optional at runtime: a missing/un-rendered file degrades to the public RPC.
# (Baked here, not as a compose `command:` — the `sh -c` form swallows extra
# command args.)
ENTRYPOINT ["/bin/sh", "-c", "exec /usr/local/bin/balance-monitor \
  --config /app/config/config.${APP_ENV}.toml \
  --secrets /run/secrets/balance-monitor.toml"]
