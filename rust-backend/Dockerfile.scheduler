# Multi-stage build for the option-scheduler.
#
# The builder runs under the target platform set by bake.hcl. Do NOT
# add `--platform=$BUILDPLATFORM` here — that would pin the builder to
# the GH runner's native arch and produce a binary that doesn't match
# the image manifest's arch.
FROM rust:1-bookworm AS builder
WORKDIR /src

RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config libssl-dev clang cmake protobuf-compiler git \
    && rm -rf /var/lib/apt/lists/*

COPY . .
RUN cargo build --release -p option-scheduler

FROM debian:bookworm-slim
# libpq5 is the runtime shared lib the scheduler binary links against for
# Postgres connections (via diesel/r2d2 — see SO-57). Without it the
# binary fails to start with `cannot open shared object file: libpq.so.5`
# before main() runs, which masks itself as a slow startup at deploy time
# (see SO-66 root-cause).
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates libssl3 libpq5 curl && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=builder /src/target/release/option-scheduler /usr/local/bin/option-scheduler
COPY services/option-scheduler/config/ /app/config/
COPY deployments.json /app/deployments.json

ENV APP_ENV=dev
# Scheduler signs with the deployer key (AdminCap holder). The
# /run/secrets/scheduler.toml is rendered at deploy time by
# render-secrets.sh from `options/<env>/scheduler` in Secrets Manager.
#
# --network is derived from APP_ENV (dev→devnet, staging→testnet,
# prod→mainnet) so the scheduler resolves the right deployments.json
# slot without a separate config knob. Mapping matches deployment.md
# and the network field in indexer/mm-bot/api-service configs.
ENTRYPOINT ["/bin/sh", "-c", "case \"$APP_ENV\" in dev) NET=devnet ;; staging) NET=testnet ;; prod) NET=mainnet ;; *) echo \"unknown APP_ENV: $APP_ENV\" >&2; exit 1 ;; esac; exec /usr/local/bin/option-scheduler --config /app/config/config.${APP_ENV}.toml --token-info-url http://token-info:9005 --secrets /run/secrets/scheduler.toml --network $NET"]
