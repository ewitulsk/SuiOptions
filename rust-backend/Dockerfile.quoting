FROM --platform=$BUILDPLATFORM rust:1-bookworm AS builder
ARG TARGETPLATFORM
WORKDIR /src

RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config libssl-dev clang cmake protobuf-compiler git \
    && rm -rf /var/lib/apt/lists/*

COPY . .
RUN cargo build --release -p quoting-service

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates libssl3 curl && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=builder /src/target/release/quoting-service /usr/local/bin/quoting-service
COPY services/quoting-service/config/ /app/config/
COPY deployments.json /app/deployments.json

ENV APP_ENV=dev
ENTRYPOINT ["/bin/sh", "-c", "exec /usr/local/bin/quoting-service --config /app/config/config.${APP_ENV}.toml"]
