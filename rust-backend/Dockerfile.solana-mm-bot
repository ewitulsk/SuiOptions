# Multi-stage build for solana-mm-bot.
#
# Build context is the REPO ROOT, not rust-backend/ (bake.hcl's
# `_solana-standalone` target sets context ".."): the bot is a standalone
# cargo workspace, like solana-indexer, but it additionally path-depends on
# the program crates in ../solana-contracts/programs — a rust-backend-only
# context can't see them. The repo-root .dockerignore keeps the context to
# rust-backend/ + solana-contracts/.
#
# The builder runs under the target platform set by bake.hcl. Do NOT
# add `--platform=$BUILDPLATFORM` here — that would pin the builder to
# the GH runner's native arch and produce a binary that doesn't match
# the image manifest's arch.
FROM rust:1-bookworm AS builder
WORKDIR /src

RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config libssl-dev clang cmake protobuf-compiler git \
    && rm -rf /var/lib/apt/lists/*

# Both trees, laid out exactly as in the repo so the workspace's
# ../../../solana-contracts path deps resolve.
COPY rust-backend/ rust-backend/
COPY solana-contracts/ solana-contracts/
RUN cargo build --release --manifest-path rust-backend/services/solana-mm-bot/Cargo.toml

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates libssl3 curl && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=builder /src/rust-backend/services/solana-mm-bot/target/release/solana-mm-bot /usr/local/bin/solana-mm-bot
COPY rust-backend/services/solana-mm-bot/config/ /app/config/

# No persistent state: the MmAccount is resolved from chain state for the
# current deployment on every boot (Sui mm-bot precedent).

ENV APP_ENV=staging
# --secrets carries the wallet keypair ([solana] <network>) + the ed25519
# quote signing seed ([mm_bot] quote_key), rendered to
# /run/secrets/solana-mm-bot.toml by render-secrets.sh. TOKEN_INFO_URL /
# ORACLE_URL / API_URL arrive via the env (set in compose).
ENTRYPOINT ["/bin/sh", "-c", "exec /usr/local/bin/solana-mm-bot \
  --config /app/config/config.${APP_ENV}.toml \
  --secrets /run/secrets/solana-mm-bot.toml"]
