# Daily bronze → silver normalization: yesterday's partition plus a 3-day
# lookback catch-up scan (idempotent — partitions are overwritten, never
# appended, spec §7). Driven by data-room-normalizer.timer.

[Unit]
Description=data-room: normalize bronze to silver (yesterday + 3-day lookback)
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/data-room
ExecStart=/usr/bin/docker compose run --rm batch normalizer coinbase --lookback-days 3
ExecStart=/usr/bin/docker compose run --rm batch normalizer hyperliquid --lookback-days 3
ExecStart=/usr/bin/docker compose run --rm batch normalizer funding-settled --coins BTC,SUI --days 3
ExecStart=/usr/bin/docker compose run --rm batch normalizer deribit --lookback-days 3
ExecStart=/usr/bin/docker compose run --rm batch normalizer aftermath --lookback-days 3
ExecStart=/usr/bin/docker compose run --rm batch normalizer bluefin --lookback-days 3
# dvol stays BTC-only: Deribit has no SUI options, which is the whole
# reason doc 07's IV ablation runs on BTC.
ExecStart=/usr/bin/docker compose run --rm batch normalizer dvol --currencies BTC --days 3
# Vision zips had NO recurring normalize step at all before SO-406 — the
# daily mirror landed new bronze that nothing ever promoted to silver.
# `normalize_pending` skips anything with a .done marker, so this is cheap
# on a no-op day and self-healing after a failed one.
ExecStart=/usr/bin/docker compose run --rm batch normalizer vision --symbols BTCUSDC,SUIUSDT,SUIUSDC
ExecStart=/usr/bin/docker compose run --rm batch normalizer vision --market um --symbols BTCUSDT,SUIUSDT
