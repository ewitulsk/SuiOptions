# Daily gold jobs, after the normalizer (spec §8): gaps ledger first (rv
# consumes its coverage), then bars, then rv. Sequential ExecStart lines —
# a failure aborts the rest and fails the unit loudly.

[Unit]
Description=data-room: daily gold jobs (gaps, bars, rv)
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/data-room
# 2-day lookback: a failed night self-heals on the next run instead of
# leaving a permanent hole (partitions are overwrite-idempotent).
ExecStart=/usr/bin/docker compose run --rm batch sh -c 'for b in 2 1; do d=$(date -u -d "$b days ago" +%%F); gold --date $d gaps && gold --date $d bars && gold --date $d rv; done'
