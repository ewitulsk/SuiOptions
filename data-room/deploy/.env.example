# Copy to /opt/data-room/.env. TAG + ECR lines are rewritten by
# deploy-data-room.yml on every deploy; anything else is preserved.
TAG=latest
ECR=registry.digitalocean.com/suioptions/options
RUST_LOG=info
# Lake root for batch jobs (Terraform output data_room_bucket):
STORE_URL=s3://REPLACE_WITH_DATA_ROOM_BUCKET
