# Copy to .env for local development. Compose/prod set these via environment.

DATABASE_URL=sqlite:///./scraper.db
SESSION_SECRET=change-me
SEED_ADMIN_PASSWORD=change-me-too
COOKIE_SECURE=false

# LiteLLM model strings — swap providers by changing the string.
#   anthropic/claude-sonnet-5, openai/gpt-4o, openrouter/deepseek/deepseek-chat, ...
TRIAGE_MODEL=anthropic/claude-haiku-4-5
FULL_MODEL=anthropic/claude-sonnet-5
# Set the key(s) for whichever provider(s) the models above use:
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=

# eBay Browse API (developer.ebay.com -> keyset)
# EBAY_CLIENT_ID=
# EBAY_CLIENT_SECRET=
EBAY_ENV=production

# DISCORD_WEBHOOK_URL=
